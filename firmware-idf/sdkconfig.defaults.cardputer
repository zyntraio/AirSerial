# AirSerial — Cardputer-Adv 专属覆盖
# Stamp-S3A 核心 (ESP32-S3FN8): 8MB Flash, 无外部 PSRAM ← 内存紧张!
# 单 Type-C: USB-SERIAL-JTAG + OTG 共享 PHY → SHARED_PHY
# 屏幕: ST7789V2 1.14"

# — 芯片 & Flash —
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# — PSRAM —
# ESP32-S3FN8 (Stamp-S3A) 无外部 PSRAM → 全靠内部 SRAM (~300KB 可用)
CONFIG_SPIRAM=n

# — Console: USB-SERIAL-JTAG GPIO19/20 —
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# — Board type —
CONFIG_BOARD_TYPE_CARD_PUTER_ADV=y

# ===== 内存优化（裸 N4，所有优化只为省 RAM）=====
# WiFi buffer 砍半: 32→16 RX + 8→4 TX → ~22KB 内部 RAM 省下
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4

# lwIP TCP window 砍半: 每连接省 ~5.76KB → ~2.88KB
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# lwIP recvmbox 缩小: 6→4
CONFIG_LWIP_TCP_RECVMBOX_SIZE=4
