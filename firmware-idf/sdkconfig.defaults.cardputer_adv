# AirSerial — M5Stack Cardputer ADV 专属覆盖
# Stamp-S3A (ESP32-S3FN8, 8MB flash, 无 PSRAM)
# 单 Type-C：USB-SERIAL-JTAG + OTG 共享 PHY → SHARED_PHY topo
# USB Host 需自供电 OTG 转接（VBUS 只进不出，同 StickS3）

# — 芯片 & Flash —
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# — 无 PSRAM（S3FN8 无内置 PSRAM，bridge 客户端连接时 portal 自动暂停省 RAM）—

# — UART —
CONFIG_UART_ISR_IN_IRAM=y

# — Console: USB-SERIAL-JTAG（唯一串口通路）—
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# — Board type —
CONFIG_BOARD_TYPE_CARD_PUTER_ADV=y
