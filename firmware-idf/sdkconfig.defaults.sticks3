# AirSerial — M5Stack StickS3 专属覆盖
# ESP32-S3-WROOM-1 (8MB flash, 8MB PSRAM, USB-SERIAL-JTAG console)
# 单 USB 口：USB-SERIAL-JTAG + OTG 共享 PHY → SHARED_PHY topo

# — 芯片 & Flash —
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# — PSRAM —
# 官网确认: ESP32-S3-PICO-1-N8R8 内置 8MB Octal PSRAM (不是Quad!)
# CAPS_ALLOC：PSRAM 只注册进 heap caps 分配器，普通 malloc 仍走内部 RAM；
# bridge_serial 的 TX ring/订阅者环显式 heap_caps_malloc(SPIRAM) 静态创建。
# 40M：实测稳定频率。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# — UART —
# 921600 回环零丢字节：ISR 放 IRAM，避免 flash/cache 操作延迟 RX 中断
CONFIG_UART_ISR_IN_IRAM=y

# — Console: USB-SERIAL-JTAG（板上只有这一个串口通路）—
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# — Board type —
CONFIG_BOARD_TYPE_STICKS3=y
